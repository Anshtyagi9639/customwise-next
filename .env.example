# Copy to .env.local and fill in. Never commit real values.

# Public canonical origin used for metadata, sitemap and structured data (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Enquiry form email (Resend). See README.md
# ---------------------------------------------------------------------------
EMAIL_API_KEY=
ENQUIRY_TO_EMAIL=anshtyagi9639@gmail.com
EMAIL_FROM=

# Optional: CRM / automation webhook for enquiries
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Chatbot live chat (uWebChat + Microsoft Teams). See docs/live-chat-uwebchat.md
# These are public identifiers, not secrets. Rebuild the site after changing them.
# ---------------------------------------------------------------------------
# The Live Chat option stays hidden until the Customer ID and either the Agent ID or the Group ID are set.
# All three appear in the embed code uWebChat generates (type "Embed" to the uWebChat bot in Teams):
#   .../uwebchat.html?agent=<Agent ID>&customer=<Customer ID>     or     ...?group=<Group ID>&customer=<Customer ID>
NEXT_PUBLIC_UWEBCHAT_CUSTOMER_ID=
# Use ONE of these two, matching your embed code
NEXT_PUBLIC_UWEBCHAT_AGENT_ID=
NEXT_PUBLIC_UWEBCHAT_GROUP_ID=

# Optional: only if uWebChat's embed code shows a host other than pool01.uwebchat.com
# NEXT_PUBLIC_UWEBCHAT_HOST=

# ---------------------------------------------------------------------------
# Blog admin at /admin-blog (blog CMS). Server-side only: never use a NEXT_PUBLIC_ name for these.
# Put real values in .env.local (local) or in the hosting panel (production); never in this file or in git.
# ---------------------------------------------------------------------------
# MongoDB Atlas: connection string from Atlas (Connect > Drivers). Use a database user with "readWrite" on MONGODB_DB only.
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=blog_cms

# Cloudinary (image uploads): from the Cloudinary console, Settings > API Keys. All three are needed.
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<numeric-api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Where the public blog (/blog, /insights/blog/...) gets its articles:
#   static = the built-in articles in lib/content/blog-posts.ts (default, as before the CMS)
#   cms    = articles published in /admin-blog. If the CMS cannot be read, the built-in articles are shown.
BLOG_SOURCE=static

# For local tests only, never on the server:
#   CMS_STORE=json      keep CMS records in .cms-data/db.json instead of MongoDB (sign-in is not available then)
#   CMS_IMAGES=local    keep uploaded images in .cms-data/uploads instead of Cloudinary
# CMS_STORE=
# CMS_IMAGES=
